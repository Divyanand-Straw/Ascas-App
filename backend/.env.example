# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated if multiple, e.g. http://localhost:3000,http://localhost:8080 or * for dev)
CORS_ORIGIN=*

# PostgreSQL Connection String (Supabase)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=your_supabase_connection_string

