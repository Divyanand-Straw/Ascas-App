# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated if multiple, e.g. http://localhost:3000,http://localhost:8080 or * for dev)
CORS_ORIGIN=*

# PostgreSQL Connection String (Supabase)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=your_supabase_connection_string

# Set true only with a disposable loopback test database.
DEV_PERSISTENT_AUTH=false

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Optional isolated staging mode. Never use production credentials or patient data.
# The database URL must target a local PostgreSQL database ending in _dev, _development, _test, or _staging.
APP_ENV=
STAGING_DATABASE_URL=
STAGING_DATABASE_DISPOSABLE=
JWT_ACCESS_SECRET=
OTP_SECRET=

# Real Brevo delivery is opt-in in staging and restricted to this comma-separated recipient allowlist.
STAGING_BREVO_ENABLED=
STAGING_BREVO_ALLOW_ALL_RECIPIENTS=false
STAGING_EMAIL_ALLOW_ANY_RECIPIENT=false
STAGING_EMAIL_ALLOWED_RECIPIENTS=
STAGING_DEVELOPER_EMAIL_OTP_TEST_ENABLED=false
STAGING_DEVELOPER_EMAIL_OTP_MAX_REQUESTS_PER_HOUR_PER_EMAIL=5
STAGING_DEVELOPER_EMAIL_OTP_MAX_REQUESTS_PER_HOUR_PER_IP=15

# Development SMS provider can print OTPs to the terminal only in development or staging.
DEV_OTP_TERMINAL_LOG_ENABLED=false

# Optional OTP viewer for local testing only. Requires APP_ENV=development or staging,
# a 43+ character base64url secret, and comma-separated E.164 test phone allowlist.
# The endpoint accepts loopback requests only and is never mounted in production.
DEV_OTP_VIEWER_ENABLED=false
DEV_OTP_VIEWER_SECRET=
DEV_OTP_VIEWER_ALLOWED_PHONES=

# Optional local Brevo email test. Requires APP_ENV=development,
# DEV_PERSISTENT_AUTH=true, and an isolated local test database.
DEV_EMAIL_OTP_TEST_ENABLED=false
DEV_EMAIL_ALLOWED_RECIPIENTS=
# Set true only in development to skip the recipient allowlist for valid emails.
DEV_EMAIL_ALLOW_ALL_RECIPIENTS=false

